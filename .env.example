# ====== 必填 ======
# 飞书开放平台自建应用的凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格的 app_token：
# 打开表格，浏览器地址栏形如 https://xxx.feishu.cn/base/BBBBBBBBBBBB/?table=tblXXXX
# 其中 base/ 后面那串 BBBBBBBBBBBB 就是它
FEISHU_BASE_TOKEN=BBBBBBBBBBBBBBBB

# 三张表的 table ID，地址栏 ?table= 后面那串
FACT_TABLE_ID=tblxxxxxxxx
DOC_TABLE_ID=tblxxxxxxxx
DESIGN_TABLE_ID=tblxxxxxxxx

# ====== 可选 ======
# 群机器人 webhook 地址（群设置 → 群机器人 → 添加自定义机器人）。留空则不发群提醒
FEISHU_WEBHOOK_URL=

# 你的飞书租户域名（如 xxx.feishu.cn）。仅 bootstrap_bitable.py 用于打印表格地址
FEISHU_TENANT_DOMAIN=
